# Distribución mínima: solo se publican los archivos de esta lista.
/*
!/.gitignore
!/README.md
!/panorama.jpg
!/requirements.txt
!/app.py
!/charts.py
!/metrics.py
!/formatting.py
!/ui.py
!/editorial.css
!/graficos_vscode.py
!/sync_sources.py

!/.streamlit/
/.streamlit/*
